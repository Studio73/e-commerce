#!/bin/bash
# (c) Studio73 - Pablo Fuentes <pablo@studio73.es>

set -ex
CODE=$1
find $CODE -name "*.po" | grep -v -E "es.po|en_GB.po|fr.po|pt.po|it.po|de.po|ca.po" | xargs --no-run-if-empty rm
find $CODE -name ".git" | xargs --no-run-if-empty rm -rf
find $CODE -name "setup" | xargs --no-run-if-empty rm -rf
find $VIRTUAL_ENV -name "*.pyc" -exec rm -f {} \;
rm -rf /tmp/*
