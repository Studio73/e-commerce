#!/usr/bin/env python3
# (c) Studio73 - Pablo Fuentes <pablo@studio73.es>

import ast
import glob
import logging
import os
import re
import subprocess as sp
import sys
import tempfile
import time
from datetime import datetime, timedelta

import click
from click_odoo_contrib._dbutils import advisory_lock, pg_connect
from tabulate import tabulate

logging.basicConfig(
    format="%(asctime)s %(levelname)s: %(message)s",
    level=logging.INFO,
)
_logger = logging.getLogger(__name__)


def get_addons():
    addons = {}
    for manifest in glob.glob("{}/custom/**/__manifest__.py".format(os.environ["SRC"])):
        fil = os.path.basename(os.path.dirname(manifest))
        m = ast.literal_eval(open(manifest, "r").read())
        if m.get("installable", True):
            addons[fil] = m.get("depends", [])
    return addons


def parse_log(logfile):
    def strip_ansi_escape(data):
        """Remove all ANSI escapes from string or bytes.

        If bytes is passed instead of string, it will be converted to string
        using UTF-8.
        """
        if isinstance(data, bytes):
            data = data.decode("utf-8")

        return re.sub(r"\x1b[^m]*m", "", data)

    # '<DATE> ERROR <DATABASE> odoo.modules.loading: Module <MODULE>: 1 failures...
    re_err = re.compile(
        r"^(?P<date>.*)ERROR(.*)Module(?P<module>.*):(.*) failures,(.*)$"
    )
    re_warn = re.compile(
        r"^(?P<date>.*?)WARNING (?P<database>.*?) (?P<logger>.*?): (?P<warning>.*?)$"
    )
    re_unable2install = re.compile(
        r'^(.*)Unable to install module "(?P<module>.*?)"(.*)$'
    )
    result = {"error": [], "warning": [], "critical": []}
    logfile.seek(0)
    for idx, line in enumerate(logfile.readlines()):
        line = strip_ansi_escape(line.strip())
        if "ERROR" in line:
            err_match = re_err.match(line)
            if err_match:
                result["error"].append(err_match.groupdict()["module"].strip())
        elif "CRITICAL" in line:
            result["critical"].append(idx)
        elif "WARNING" in line:
            warn_match = re_warn.match(line)
            if warn_match:
                warn_dict = warn_match.groupdict()
                warn_logger = warn_dict["logger"].strip()
                if warn_logger == "odoo.tests.runner":
                    # Test results: 0 failed, 0 error(s) of 0 tests when loading database
                    continue
                warn_msg = warn_dict["warning"].strip()
                if (warn_logger, warn_msg) not in result["warning"]:
                    result["warning"].append((warn_logger, warn_msg))
    for critical_idx in result.get("critical", []):
        logfile.seek(critical_idx)
        for line in logfile.readlines():
            line = strip_ansi_escape(line.strip())
            # XML Error eg: Element '<xpath expr="...">' cannot be located in parent view
            if line.startswith("file: "):
                module = os.path.basename(line.split("/views/")[0])
                result["error"].append(module)
            elif re_unable2install.match(line):
                result["error"].append(
                    re_unable2install.match(line).groupdict()["module"].strip()
                )
    return result


def print_table(rows, headers=None, showindex=None):
    if headers is None:
        headers = []
    click.echo(tabulate(rows, headers=headers, tablefmt="psql", showindex=showindex))
    click.echo("")


def purgedb(database):
    def _dropdb(name):
        return sp.call(
            ["dropdb", "--if-exists", name], stdout=sp.DEVNULL, stderr=sp.DEVNULL
        )

    _dropdb(database)
    with pg_connect() as pgcr:
        name_pat = "test-{}-%".format("_" * 12)
        date_pat = "test-{}-".format(
            (datetime.utcnow() - timedelta(7)).strftime("%y%m%d%H%M%S")
        )
        with advisory_lock(pgcr, date_pat):
            pgcr.execute(
                """
                SELECT datname FROM pg_database
                WHERE datname like %s
                AND datname <= %s
                ORDER BY datname DESC
                """,
                (name_pat, date_pat),
            )
            for (datname,) in pgcr.fetchall():
                _dropdb(datname)


@click.group()
def test():
    pass


@test.command()
@click.option("-l", "--log-level", default="warn")
@click.option("-L", "--language", default="en_US")
@click.argument("addons", default="")
def run(addons, language, log_level):
    start_time = time.time()
    database = "test-{}-{}".format(
        datetime.now().strftime("%y%m%d%H%M%S"),
        os.environ.get("PGDATABASE", "odoo"),
    )
    addons_dict = get_addons()
    custom_addons = addons_dict.keys()
    if addons:
        addons = [m.strip() for m in addons.split(",") if m.strip() in custom_addons]
    else:
        addons = custom_addons
    if not addons:
        raise Exception("No addons to test")
    dependencies = []
    for a in addons:
        dependencies += addons_dict[a]
    # Compute addons dependencies discarting addons from current repo
    dependencies = list(set(dependencies) - set(custom_addons))
    purgedb(database)
    install_cmd = [
        "click-odoo-initdb",
        "-m",
        ",".join(dependencies),
        "-n",
        database,
        "--cache-max-age=7",
        "--unless-exists",
    ]
    _logger.info(
        "{}: {}".format(
            click.style("Initializing database", fg="green", bold=True),
            " ".join(install_cmd),
        )
    )
    try:
        sp.check_call(install_cmd)
    except sp.CalledProcessError as e:
        purgedb(database)
        sys.exit(e.returncode)
    coverage_cmd = ["unbuffer", "coverage", "run"]
    odoo_cmd = [
        "{}/odoo/odoo/odoo-bin".format(os.environ["SRC"]),
        "--database=%s" % database,
        "--db-filter=^%s$" % database,
        "--log-level=%s" % log_level,
        "--load-language=%s" % language,
        "--language=%s" % language,
        "--stop-after-init",
        "--workers=0",
        "--init",
        ",".join(addons),
        "--test-enable",
    ]
    custom_path = os.path.join(os.environ["SRC"], "custom")
    rcfile = os.path.join(custom_path, ".coveragerc")
    if os.path.exists(rcfile):
        coverage_cmd += ["--rcfile={}".format(rcfile)]
    tests_cmd = coverage_cmd + odoo_cmd
    _logger.info(
        "{}: {}".format(
            click.style("Running tests", fg="green", bold=True), " ".join(tests_cmd)
        )
    )
    pipe = sp.Popen(tests_cmd, stderr=sp.STDOUT, stdout=sp.PIPE, cwd=custom_path)
    logfile = tempfile.TemporaryFile()
    for line in iter(pipe.stdout.readline, b""):
        logfile.write(line)
        click.echo(line.strip().decode("UTF-8", errors="backslashreplace"))
    result = parse_log(logfile)
    logfile.close()
    returncode = pipe.wait()
    if result.get("critical") or result.get("error"):
        returncode = 254
    if result.get("warning"):
        print_table(result["warning"], ["Logger", "Warning message"], True)
    addons_table = []
    errors = set(result.get("error", []))
    for addon in sorted(addons):
        depends = addons_dict[addon]
        if addon in result.get("error", []):
            addons_table.append([addon, "❌"])
        elif any(d in errors for d in depends):
            addons_table.append([addon, "❌"])
        else:
            addons_table.append([addon, "✅"])
    print_table(
        addons_table,
        ["Module", "Result"],
        True,
    )
    elapsed_time = round(time.time() - start_time, 2)
    elapsed_time = time.strftime("%Hh %Mm %Ss", time.gmtime(elapsed_time))
    if returncode != 0:
        if result.get("error"):
            _logger.info(
                "❌ Failed ({}/{}) {}".format(
                    len(result["error"]), len(addons), elapsed_time
                )
            )
        else:
            _logger.info("❌ Failed {}".format(elapsed_time))
    else:
        _logger.info("✅ Succeed {}".format(elapsed_time))
    purgedb(database)
    sys.exit(returncode)


@test.command()
@click.option("-f", "--fail-under", default=0, type=int)
@click.argument("addons", default="")
def coverage(addons, fail_under):
    custom_path = os.path.join(os.environ["SRC"], "custom")
    diff_addons = []
    if addons:
        diff_addons = [m.strip() for m in addons.split(",")]
    coverage_cmd = ["coverage", "report", "-m"]
    if fail_under:
        coverage_cmd += ["--fail-under={}".format(fail_under)]
    rcfile = os.path.join(custom_path, ".coveragerc")
    if os.path.exists(rcfile):
        coverage_cmd += ["--rcfile={}".format(rcfile)]
    total = "~"
    pipe = sp.Popen(coverage_cmd, stderr=sp.STDOUT, stdout=sp.PIPE, cwd=custom_path)
    for line in iter(pipe.stdout.readline, b""):
        line = line.strip().decode("UTF-8", errors="backslashreplace")
        click.echo(line)
        if "TOTAL" in line:
            total = line.split()[-1]
    project_exit = pipe.wait()
    patch_exit = 0
    print_table(
        [["☔Project coverage", "{} {}".format("❌" if project_exit else "✅", total)]]
    )
    if diff_addons:
        diff_addons = ["{}*".format(a) for a in diff_addons]
        coverage_cmd.append("--include={}".format(",".join(diff_addons)))
        total = "~"
        pipe = sp.Popen(coverage_cmd, stderr=sp.STDOUT, stdout=sp.PIPE, cwd=custom_path)
        for line in iter(pipe.stdout.readline, b""):
            line = line.strip().decode("UTF-8", errors="backslashreplace")
            click.echo(line)
            if "TOTAL" in line:
                total = line.split()[-1]
        patch_exit = pipe.wait()
        print_table(
            [["☔Patch coverage", "{} {}".format("❌" if patch_exit else "✅", total)]]
        )
    sys.exit(project_exit or patch_exit)


if __name__ == "__main__":
    test()
