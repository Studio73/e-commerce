# (c) Studio73 - Pablo Fuentes <pablo@studio73.es>

__import__("os").environ["TZ"] = "UTC"
import os
import odoo


def debug_vscode(port):
    import debugpy

    debugpy.listen(("0.0.0.0", port))


def debug_pycharm(port):
    import pydevd_pycharm

    pydevd_pycharm.settrace(
        "0.0.0.0", port=port, stdoutToServer=True, stderrToServer=True
    )


if __name__ == "__main__":
    debugger = os.environ.get("DEBUGGER", "debugpy")
    port = os.environ.get("DEBUGGER_PORT", "5678")
    if debugger == "debugpy":
        debug_vscode(port)
    elif debugger == "pydevd":
        debug_pycharm(port)
    odoo.cli.main()
