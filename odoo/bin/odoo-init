#!/usr/bin/env python3
# (c) Studio73 - Pablo Fuentes <pablo@studio73.es>

import logging
import os
import subprocess as sp
import sys
import time

import click
import psycopg2

logging.basicConfig(
    format="%(asctime)s %(levelname)s: %(message)s",
    level=logging.INFO,
)
_logger = logging.getLogger(__name__)


def is_initialized(database):
    is_initialized = False
    try:
        with psycopg2.connect(f"dbname={database}") as conn:
            with conn.cursor() as cur:
                query = """
                    SELECT c.relname
                    FROM pg_class c
                    JOIN pg_namespace n ON (n.oid = c.relnamespace)
                    WHERE c.relname = 'ir_module_module'
                    AND c.relkind IN ('r', 'v', 'm')
                    AND n.nspname = current_schema
                """
                cur.execute(query)
                rec = cur.fetchone()
                is_initialized = bool(rec)
    except psycopg2.OperationalError:
        pass
    return is_initialized


def pg_isready():
    # wait for postgres to be ready
    sleep = 1
    while sleep < 64:
        if sp.call(["pg_isready"]) == 0:
            break
        _logger.info("Waiting for postgres...")
        time.sleep(sleep)
        sleep = sleep * 2
    else:
        raise SystemExit("postgres is not ready, giving up")


def run_restic(args):
    pack_size = os.environ.get("RESTIC_PACK_SIZE", "128")
    restic_cmd = [
        "restic",
        "restore",
        "--no-lock",
        f"--pack-size={pack_size}",
    ]
    cmd = restic_cmd + args
    _logger.info("Running command: %s", " ".join(cmd))
    sp.check_call(cmd, stderr=sys.stderr, stdout=sys.stdout)


def restore_fs(database):
    fs_path = os.path.join(os.environ["DATA"], "filestore", database)
    if os.path.exists(fs_path):
        _logger.info("Filestore already restored")
        return
    snapshot_id = os.environ.get("RESTIC_SNAPSHOT_ID", "latest")
    run_restic([f"{snapshot_id}:fs", f"--target={fs_path}"])
    _logger.info("Filestore restored")


def restore_db(database):
    backup_path = os.path.join("/tmp", f"{database}.dump")
    if os.path.exists(backup_path):
        _logger.info("Using existing dump")
    else:
        snapshot_id = os.environ.get("RESTIC_SNAPSHOT_ID", "latest")
        run_restic([f"{snapshot_id}:db", f"--target={backup_path}"])
    pg_isready()
    _logger.info(f"Restoring database {database}")
    sp.check_call(
        ["createdb", "-U", os.environ["PGUSER"], "-O", os.environ["PGUSER"], database]
    )
    jobs = os.environ.get("RESTIC_RESTORE_JOBS", "2")
    sp.check_call(
        [
            "pg_restore",
            "--no-comments",
            "-Ox",
            f"-j{jobs}",
            "-d",
            database,
            backup_path,
        ],
    )
    _logger.info("Database restored")


@click.command()
@click.option("--database", default="odoo", envvar="PGDATABASE", help="Database name")
@click.option("--repository", envvar="RESTIC_REPOSITORY", help="Restic repository")
@click.option(
    "--no-fs",
    is_flag=True,
    envvar="RESTORE_SKIP_FS",
    help="If repository is set, skip filestore restore",
)
@click.option(
    "--no-neutralize",
    is_flag=True,
    envvar="RESTORE_SKIP_NEUTRALIZE",
    help="If repository is set, skip neutralize",
)
def main(database, repository, no_fs, no_neutralize):
    if repository:
        if not is_initialized(database):
            restore_db(database)
            if not no_neutralize:
                sp.check_call(["odoo", "neutralize", "-d", database])
            if not no_fs:
                restore_fs(database)
        _logger.info("Updating database")
        sp.check_call(["click-odoo-update"])
    else:
        pg_isready()
        if is_initialized(database):
            _logger.info("Updating database")
            sp.check_call(["click-odoo-update"])
        else:
            _logger.info(f"Initializing database {database}")
            sp.check_call(
                [
                    "odoo",
                    "-i",
                    "web,base,studio73_saas_agent",
                    "--load-language=es_ES",
                    "-d",
                    database,
                    "--stop-after-init",
                ]
            )


if __name__ == "__main__":
    main()
