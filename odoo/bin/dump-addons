#!/bin/env python3
# (c) Studio73 - Pablo Fuentes <pablo@studio73.es>
import glob
import logging
import os
import subprocess as sp
from datetime import datetime

import click

logging.basicConfig(
    format="%(asctime)s %(levelname)s: %(message)s",
    level=logging.INFO,
)
_logger = logging.getLogger(__name__)

BLACKLIST = ["studio73_saas_agent"]


@click.command()
@click.option("--dump-name", help="Dump name\tdefault: DBNAME_addons_NOW")
@click.option("--dest", default="/opt/odoo/backup", help="Backup destination\tdefault: /opt/odoo/backup")
def main(dest, dump_name):
    dbname = os.environ["PGDATABASE"]
    if not dump_name:
        now = datetime.now().strftime("%Y-%m-%d_%H%M%S")
        dump_name = f"{dbname}_addons_{now}"
    dump_name = os.path.join(dest, f"{dump_name}.tar.gz")
    query = "select name from ir_module_module where state in ('installed', 'to upgrade') order by name"
    query_out = sp.Popen(
        ["psql", "-t", "-d", dbname, "-c", query], stdout=sp.PIPE
    ).communicate()[0]
    addons_out = query_out.decode("utf-8").strip().split()

    if not len(addons_out):
        _logger.error("No addons found in %s" % dbname)
        exit(75)
    sp.call(["rm", "-rf", dbname], cwd="/tmp")
    sp.call(["mkdir", "-p", dbname], cwd="/tmp")
    routes = [
        "/opt/odoo/src/oca/**/%s",
        "/opt/odoo/src/custom/%s",
        "/opt/odoo/src/studio73/common/**/%s",
        "/opt/odoo/src/studio73/extra/**/%s",
        "/opt/odoo/src/studio73/zenterprise/studio73-enterprise-addons/%s",
    ]
    for addon in addons_out:
        if addon in BLACKLIST:
            continue
        for route in routes:
            _addon = glob.glob(route % addon)
            if _addon:
                src = _addon[0]
                dest = src.replace(os.environ["SRC"], "/tmp/%s" % dbname)
                sp.call(["mkdir", "-p", os.path.split(dest)[0]])
                sp.call(["cp", "-r", src, dest])
                continue
    _tmp = f"/tmp/{dbname}"
    sp.call(["find", ".", "-name", "*.pyc", "-delete"], cwd=_tmp)
    sp.call(["find", ".", "-name", "__pycache__", "-delete"], cwd=_tmp)
    sp.call(["mkdir", "-p", dest])
    sp.call(["tar", "-cf", dump_name, "."], cwd=_tmp)
    sp.call(["rm", "-rf", dbname], cwd="/tmp")
    _logger.info("Addons dumped at %s" % dump_name)


if __name__ == "__main__":
    main()
