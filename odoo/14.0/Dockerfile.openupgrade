ARG  base_image=r.studio73.es/odoo/community:14
FROM ${base_image} as builder
COPY --chown=odoo 14.0/openupgrade.yaml /code/openupgrade.yaml
RUN cd /code && gitaggregate --jobs 8 --config openupgrade.yaml

FROM ${base_image}
COPY --chown=odoo --from=builder /code $SRC/oca
ENV OPENUPGRADE_TARGET_VERSION=14.0
