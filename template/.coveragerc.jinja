[run]
source = .
omit = *system_site_packages*, *site-packages*, *dist-packages*, *virtualenv*, *tests*, *__manifest__.py, {{ excluded_coverage_addons }}
[report]
# Regexes for lines to exclude from consideration
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover
    # Don't complain if non-runnable code isn't run:
    if __name__ == .__main__.:
