import os
import uuid
import re

from dotenv import dotenv_values
from invoke import task

PROJECT = "{{ project_name }}"
DOCKER_REGISTRY = "r.studio73.es"
{%- if image %}
DOCKER_IMAGE = "{{ image.replace('r.studio73.es/', '') }}:{{ odoo_version }}"
{%- else %}
DOCKER_IMAGE = "odoo/{{ odoo_edition }}:{{ odoo_version }}"
{%- endif %}



@task
def build(c):
    c.run("docker pull {{ base_image }}:{{ odoo_version }}", pty=True)
    c.run("docker buildx build -t {} .".format(DOCKER_IMAGE), pty=True)
    c.run("docker tag {} {}/{}".format(DOCKER_IMAGE, DOCKER_REGISTRY, DOCKER_IMAGE), pty=True)


@task
def pull(c):
    c.run("docker pull {}/{}".format(DOCKER_REGISTRY, DOCKER_IMAGE), pty=True)


@task
def run(c, port="8069"):
    exec(c, "odoo", port=port, name=None)


@task
def dev(c, port="8069"):
    exec(c, "odoo --dev=all", port=port, name=None)


@task
def debug(c, port="8069"):
    exec(c, "odoo-debug", port=port, name=None)


@task
def update(c):
    exec(c, "odoo-update", port=None, name=None)


@task
def shell(c):
    exec(c, "odoo shell --no-xmlrpc", port=None, name=None)


@task
def lint(c):
    if not os.path.exists(".git/hooks/pre-commit"):
        c.run("pre-commit install", pty=True)
    c.run("pre-commit run -a", pty=True)


@task
def test(c):
    exec(c, "bash -c 'odoo-test run && odoo-test coverage'", port=None, name=None)


@task
def exec(c, cmd="bash", port="8069", name=PROJECT):
    if not name:
        _id= str(uuid.uuid4()).split("-")[0]
        name = "{}_{}".format(PROJECT, _id)
    home = os.path.expanduser("~")
    cwd = os.getcwd()

    def get_env():
        pwd = os.getcwd()
        while pwd != "/":
            if ".env" in os.listdir(pwd):
                return os.path.join(pwd, ".env")
            pwd = os.path.dirname(pwd)
        return False

    env_file = get_env()
    if not env_file:
        print(".env not found")
        exit(75)
    config = dotenv_values(env_file)
    dockercmd = [
        "docker",
        "run",
        "--rm",
        "-it",
        "--net={}".format(config.get("NET", "bridge")),
        "--name={}".format(name),
        "--env-file={}".format(env_file),
        "--env=PGDATABASE={}".format(PROJECT),
        "--volume={}/.config/dodoo/data:/opt/odoo/data".format(home),
        "--volume={}/.config/dodoo/backup:/opt/odoo/backup".format(home),
        "--volume={}:/opt/odoo/src/custom".format(cwd),
    ]
    volume_base_path = os.path.dirname(os.path.dirname(cwd))
    for volume in config.get("VOLUMES", "").split(","):
        if not volume:
            continue
        volume_src = os.path.join(volume_base_path, volume)
        volume_dest = os.path.join("/opt/odoo/src", volume)
        if not os.path.exists(volume_src):
            print("{}: Path not found".format(volume_src))
            exit(75)
        dockercmd += ["--volume={}:{}".format(volume_src, volume_dest)]
    if port:
        dockercmd += ["--publish={}:8069".format(config.get("PORT", port))]
    if cmd == "odoo-debug":
        debugger_port = config.get("DEBUGGER_PORT", "5678")
        dockercmd += ["--publish={}:{}".format(debugger_port, debugger_port)]
    dockercmd += ["{}/{}".format(DOCKER_REGISTRY, DOCKER_IMAGE), cmd]
    c.run(" ".join(dockercmd), pty=True)


@task
def commit(c):
    result = c.run("pip3 list | grep cz-73 | wc -l", hide="both")
    if result.stdout.strip() == "0":
        c.run(
            "pip3 install --user git+ssh://git@github.com/Studio73/cz_73.git", pty=True
        )
    if not os.path.exists(".git/hooks/pre-commit"):
        c.run("pre-commit install", pty=True)
    c.run("cz -n cz_73 c", pty=True)


@task
def pr(c):
    c.run("git push --set-upstream")
    result = c.run(
        "git log --pretty=format:'%D' HEAD^ | grep 'origin/' | head -n1 | sed 's@origin/@@' | sed 's@,.*@@'",
        hide="both",
    )
    base = result.stdout.strip()
    current = c.run("git rev-parse --abbrev-ref HEAD", hide="both").stdout.strip()
    commits_short = c.run(
        "git --no-pager log --format=%s origin/{}..HEAD".format(base), hide="both"
    ).stdout.strip()
    czs = re.findall(
        "(?P<type>(\\w)*)(?P<scope>\\(\\w+\\))?(?P<breaking>!)?:", commits_short
    )
    _type = "fix"
    for commit in czs:
        if commit[3] == "!":
            _type = "!"
            break
        elif commit[0] != "fix":
            _type = "feat"
    diff = c.run(
        "git --no-pager diff --name-only origin/{} HEAD | sort".format(base),
        hide="both",
    ).stdout.strip()
    modules = []
    for change in diff.split():
        change_dir = change.split("/")[0]
        if os.path.isdir(change_dir) and os.path.exists(
            os.path.join(change_dir, "__manifest__.py")
        ):
            modules.append(change_dir)
    title = "{}\\({}\\):%20{}".format(_type.lower(), base, ",".join(modules))
    pr_url = "https://github.com/Studio73/{{ repo_name }}/compare/{}...{}?quick_pull=1\\&title={}".format(
        base, current, title
    )
    c.run("python3 -mwebbrowser {}".format(pr_url))
