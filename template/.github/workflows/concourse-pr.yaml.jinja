name: Concourse (PR)
on:
  pull_request:
    branches:
      - {{ odoo_version }}.0
    types: [ready_for_review, opened, synchronize, reopened]
jobs:
  trigger-resource-check:
    runs-on: ubuntu-20.04
    if: "github.event.pull_request.draft == false"
    steps:
      - name: Trigger PR
        uses: gstackio/trigger-concourse-resource-check-action@v1
        with:
          concourse-url: https://ci.studio73.dev
          concourse-team: {{ ci_team }}
          concourse-pipeline: {{ project_name }}
          concourse-resource: pr
          {%- if ci_instance %}
          concourse-webhook-token: {% raw %}${{{% endraw %} secrets.CONCOURSE_WEBHOOK_TOKEN_{{ odoo_version }} {% raw %}}}{% endraw %}
          {%- else %}
          concourse-webhook-token: {% raw %}${{ secrets.CONCOURSE_WEBHOOK_TOKEN }}{% endraw %}
          {%- endif %}
