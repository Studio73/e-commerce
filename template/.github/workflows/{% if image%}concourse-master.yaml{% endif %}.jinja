name: Concourse (Master)
on:
  push:
    branches:
      - {{ odoo_version }}.0
jobs:
  concourse-resource-webhook:
    runs-on: ubuntu-20.04
    steps:
      - name: Trigger repo
        uses: studio73/concourse-resource-webhook@1.0.0
        with:
          team: {{ ci_team }}
          pipeline: {{ project_name }}
          resource: repo
          token: {% raw %}${{ secrets.CONCOURSE_WEBHOOK_TOKEN }}{% endraw %}
          {%- if ci_instance %}
          vars: vars.version={{ odoo_version }}
          {%- endif %}
