  {%- set repo_rev.pre_commit_hooks = "v4.3.0" %}
  {%- set repo_rev.prettier = "2.7.1" %}
  {%- set repo_rev.prettier_xml = "2.2.0" %}
  {%- set repo_rev.pylint_odoo = "v8.0.19" %}
