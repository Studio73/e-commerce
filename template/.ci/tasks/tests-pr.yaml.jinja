---
{%- if ci_instance %}
{%- set  odoo_version = "((version))" %}
{%- endif %}
platform: linux

image_resource:
  type: registry-image
  source:
    username: ((REGISTRY_USER))
    password: ((REGISTRY_SECRET))
    repository: r.studio73.es/odoo/{{ odoo_edition }}
    tag: {{odoo_version}}
inputs:
  - name: custom
    path: /opt/odoo/src/custom
run:
  user: root
  path: python3
  args:
    - /entrypoint.py
    - bash
    - -ceux
    - |
      install-requirements /opt/odoo/src/custom
      odoo-test run
      odoo-test coverage
